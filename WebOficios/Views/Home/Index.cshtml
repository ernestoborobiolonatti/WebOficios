@model IEnumerable<WebOficios.Models.Publicacion>

@{
    ViewData["Title"] = "Inicio - Web de Oficios";
}

<!-- seccion Principal -->
<div class="text-dark py-5 mb-5 rounded-3 text-center" style="background: #e8f5e9; border: 1px solid #c8e6c9;">
    <div class="container py-4">
        <h1 class="display-4 fw-bold text-dark">Encuentra al profesional ideal para tu hogar</h1>
        <p class="lead mb-4">Busca publicaciones de plomeros, electricistas y carpinteros en tu zona.</p>

        <!-- buscador -->
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form action="@Url.Action("Index", "Home")" method="get" class="d-flex gap-2 bg-white p-2 rounded-pill shadow-sm border">
                    <input class="form-control border-0 rounded-pill ps-4" type="search" name="buscarTexto" placeholder="¿Qué oficio o localidad necesitas? (Ej: Electricista, Flores...)" aria-label="Buscar">
                    <button class="btn btn-success rounded-pill px-4 fw-bold" type="submit">Buscar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- seccion de Publicaciones Destacadas -->
<div class="container mb-5">
    <h2 class="text-center mb-4 fw-bold">Publicaciones Disponibles</h2>

    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var publicacion in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="mb-3 d-flex justify-content-between align-items-center">
                                <span class="badge bg-success">@publicacion.Categoria</span>
                                <span class="text-muted small">📍 @publicacion.Localidad</span>
                            </div>

                            <h5 class="card-title mb-2 fw-bold">@publicacion.Titulo</h5>
                            <p class="card-text text-muted">@publicacion.Descripcion</p>

                            <div class="mt-3">
                                <span class="fw-bold text-dark fs-5">Costo estimado: $@publicacion.CostoServicio</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a href="@Url.Action("Detalle", "Home", new { id = publicacion.Id })" class="btn btn-outline-dark w-100 fw-bold">Solicitar Presupuesto</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">No se encontraron publicaciones que coincidan con tu búsqueda.</p>
            </div>
        }

    </div>
</div>