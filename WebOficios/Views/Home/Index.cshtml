@model IEnumerable<WebOficios.Models.Profesionale>

@{
    ViewData["Title"] = "Inicio - Web de Oficios";
}

<!-- Seccion Principal -->
<div class="text-dark py-5 mb-5 rounded-3 text-center" style="background: #e8f5e9; border: 1px solid #c8e6c9;">
    <div class="container py-4">
        <h1 class="display-4 fw-bold text-dark">Encontra el profesional ideal para tu hogar</h1>
        <p class="lead mb-4">Plomeros, electricistas, carpinteros y más, calificados por la comunidad.</p>

        <!-- Barra de Busqueda -->
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form class="d-flex gap-2 bg-white p-2 rounded-pill shadow-sm border">
                    <input class="form-control border-0 rounded-pill ps-4" type="search" placeholder="¿Qué oficio necesitas? (Ej: Electricista, Plomero...)" aria-label="Buscar">
                    <button class="btn btn-success rounded-pill px-4 fw-bold" type="submit">Buscar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Seccion Destacados -->
<div class="container mb-5">
    <h2 class="text-center mb-4 fw-bold">Profesionales Disponibles</h2>

    <!-- Grid Bootstrap -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var profesional in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="mb-3">
                                <!-- SQL -->
                                <h5 class="card-title mb-1 fw-bold">@profesional.NombreProfesional</h5>
                                
                                <span class="badge bg-success">@profesional.Categoria?.NombreCategoria</span>
                            </div>
                            <p class="card-text text-muted">Especialista disponible en el rubro. Ofrece servicios garantizados a la comunidad.</p>
                            <div class="mb-3 text-warning">
                                ★ ★ ★ ★ ★ <span class="text-muted small">(Nueva reseña)</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <button class="btn btn-outline-dark w-100 fw-bold">Ver Perfil y Contactar</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">No se encontraron profesionales disponibles en este momento.</p>
            </div>
        }

    </div>
</div>
